# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build auth email links. Leave blank for local dev.
NEXT_PUBLIC_SITE_URL=

# Sending tenant statements (resend.com). Without these the manual button
# reports that email is not configured and nothing is sent.
RESEND_API_KEY=
STATEMENT_FROM_EMAIL=

# Shared secret for the daily cron at /api/cron/statements. Vercel sends it as
# "Authorization: Bearer <value>". Without it the route refuses to run.
CRON_SECRET=
